<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "portable", pasted into the iLEAPP repository.
  SignPath uses its own copy, so edit both in case of changes.

  release.yml uploads the single-file Windows executable as one GitHub artifact, which
  GitHub zips, with ileapp.exe at its root. bin/unifiedlog_iterator.exe is packed inside
  it and is not signed on its own: that is Mandiant's binary, and our signature would
  vouch for code we did not build.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="ileapp.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
